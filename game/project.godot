; Engine configuration file.
config_version=5

[application]
config/name="Castle TIME"
config/description="A time-travel laser adventure. Made with Blender + Godot."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.03, 0.06, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]
G="*res://scripts/game.gd"
Audio="*res://scripts/audio.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)

[physics]
common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[importer_defaults]
texture={"compress/mode": 1, "compress/lossy_quality": 0.82, "mipmaps/generate": true}
scene={"meshes/light_baking": 0, "animation/fps": 24}

[input]

[debug]
gdscript/warnings/inference_on_variant=1
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_signal=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/static_called_on_instance=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/redundant_await=0
